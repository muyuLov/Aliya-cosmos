DEEPSEEK_API_KEY="sk-your-key-here"
NEO4J_PASSWORD="Aliya_neo4j"       # Neo4j 数据库密码（可选，不设置时使用 main.yml 中的值）

# ── 应用 / 容器编排相关（docker-compose 读取）──
WS_HOST="0.0.0.0"                  # 容器内监听地址，暴露给宿主机（本地运行保持 127.0.0.1）
WS_PORT="8765"                     # 容器内监听端口
NEO4J_HOST="neo4j"                 # compose 网络内 Neo4j 服务名（本地运行保持 127.0.0.1）
NEO4J_PORT="7687"                  # Neo4j Bolt 端口
NEO4J_BROWSER_PORT="7474"          # Neo4j 浏览器端口
ASTRA_PORT="5000"                  # AstraTTS 服务端口（可选，默认 edge TTS 不需要）
APP_PORT="8765"                    # 宿主机映射端口